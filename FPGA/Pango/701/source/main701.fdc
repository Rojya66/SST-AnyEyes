create_clock -name clk_20m -period 50.000 [get_ports {CLK20M_IN}]
create_generated_clock -name clk_100m -source [get_ports {CLK20M_IN}] [get_pins {clock_100M/u_gpll:CLKOUT0}] -master_clock clk_20m -edges {1 2 3} -edge_shift {0.000 -20.000 -40.000} -add